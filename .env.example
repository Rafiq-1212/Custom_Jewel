# Copy to `.env.local` and fill in your real key.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
#
# Server-only. NEVER prefix this with NEXT_PUBLIC_ — that would inline it
# into the browser bundle. It is read only in lib/gemini.ts, on the server.
GEMINI_API_KEY=

# Die-cut service (lib/diecut-service.ts). Points at the Python service in
# ../diecut-service (see that folder's README/Dockerfile). Leaving this
# unset falls back to a mock implementation — safe to omit locally.
DIECUT_URL=http://localhost:8000
DIECUT_TOKEN=dev-token-change-me

# remove.bg (https://www.remove.bg/api). Backs Edge Cut → Free Edge Cut's
# subject boundary ONLY — Standard Pendant and every other Edge Cut style
# never call it. Server-only, read in lib/remove-bg.ts and used exclusively
# by /api/edge-cut/remove-background; never sent to or read by the browser.
# Leaving this unset makes Free Edge Cut fail over to the free, local
# silhouette tracers (lib/photo-silhouette.ts / lib/edge-cut-contour.ts)
# rather than breaking the feature outright.
REMOVE_BG_API_KEY=
