# The admin panel's environment. Real values live in the Vercel project
# (true-b-admin) and in admin/.env.local, never in the repository.

# The shared database and image store, the same ones the pendant tool uses.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Better Auth: a long random secret, and the address the panel is served at.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://true-b-admin.vercel.app

# Needed once, on /setup, to make the first admin account.
ADMIN_SETUP_CODE=

# Rupees per dollar for showing costs, and where the pendant tool lives.
INR_PER_USD=95.6
TOOL_URL=https://true-b.vercel.app
