{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "true-beauty",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "pendants.goatassets.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "./Dockerfile",
      // 1/2 vCPU, 4 GiB — sharp and potrace hold several full-size rasters at once.
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "AppContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }]
}
